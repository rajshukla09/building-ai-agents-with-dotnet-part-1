@inherits LayoutComponentBase
@inject ITravelApiClient Api

<MudThemeProvider @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Chapter 10 MAF Workflow</MudText>
        <MudSpacer />
        <MudChip T="string" Color="@(_apiAvailable ? Color.Success : Color.Error)">
            @(_apiAvailable ? "API Available" : "API Unavailable")
        </MudChip>
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       OnClick="@(() => _dark = !_dark)" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 mt-14">@Body</MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _dark;
    private bool _apiAvailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _apiAvailable = await Api.CheckHealthAsync();
        StateHasChanged();
    }
}
